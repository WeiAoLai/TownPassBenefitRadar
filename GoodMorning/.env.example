# mock：瀏覽器內模擬後端（IndexedDB），不需任何伺服器，資料為示範資料
# http：呼叫 openapi.yaml 定義的真後端
VITE_API_MODE=mock
# http 模式的 API base path（openapi servers.url）
VITE_API_BASE_URL=/api/v1
# Demo 使用者 allowlist（X-Demo-User），逗號分隔；需與後端 allowlist 一致
VITE_DEMO_USERS=user-a,user-b,user-c
# 慶祝畫面「分享給親友」要分享的連結（正式上線後填台北通裡這個服務的連結）。
# 留空就用目前網站自己的首頁；開發時是本機網址，別人打不開。
VITE_SHARE_URL=
