# Database (change both passwords before EC2 deployment)
DB_NAME=good_morning
DB_USERNAME=good_morning
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password
DB_PORT=3306

# Spring Boot / Flyway
SPRING_PROFILES_ACTIVE=demo

# AWS: use an EC2 IAM role; do not put long-lived access keys in this file
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=taipei-code-fest-assets-REPLACE_ME
PRESIGNED_URL_TTL=PT15M

# Monitoring
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
LOKI_RETENTION=168h
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Local default. On EC2 set the public ALB URL, including /grafana/ and trailing slash.
GRAFANA_ROOT_URL=http://localhost/grafana/
